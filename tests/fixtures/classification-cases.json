    { "id": "T23-override-ride-not-live", "input": { "title": "오버라이드 「オーバーライド」 / 아야츠노 유니 Cover", "channelKey": "ayatsuno-yuni", "publishedAt": "2026-10-09" },
      "expected": { "category": "solo_cover", "members": ["ayatsuno-yuni"], "reviewRequired": false } },
